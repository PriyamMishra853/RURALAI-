# RuralAI backend environment.
# Copy to backend/.env and fill in. Never commit the filled-in file.

# ---- Core ----
PORT=5000
NODE_ENV=development

# Signing key for API session tokens. Generate with: openssl rand -base64 48
# In production the server refuses to start if this is missing, shorter than
# 32 characters, or one of the values previously committed to this repo.
JWT_SECRET=

# Comma-separated list of origins allowed to call the API from a browser.
# Required in production; a wildcard is never accepted.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ---- Supabase (Postgres, Auth, Storage) ----
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Public key used for client-side reads that go through row-level security.
SUPABASE_ANON_KEY=
# Server-only key. Bypasses ALL row-level security — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI providers ----
# Groq: clinical assessment synthesis and Whisper speech-to-text.
GROQ_API_KEY=
# Google Gemini: wound and injury photograph analysis.
GEMINI_API_KEY=

# ---- Retrieval (approved clinical protocols) ----
# Qdrant Cloud cluster URL for the MoHFW protocol corpus.
QDRANT_URL=
QDRANT_API_KEY=


# ---- Notifications ----
# Resend API key, used to deliver staff account invitations.
RESEND_API_KEY=

# ---- Formulary safety gate ----
# When true (default in production), medication is suppressed entirely until
# every formulary entry is signed by a registered medical practitioner.
# Set to false ONLY to demonstrate the mechanism against placeholder data.
REQUIRE_SIGNED_FORMULARY=true

# ---- Demo seed ----
# Shared password for seeded demo accounts.
DEMO_ACCOUNT_PASSWORD=Demo@Clinic2026

# ---- Super admin (npm run seed:root) ----
# Never commit real values. Passed on the command line at provision time.
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=
ROOT_ADMIN_NAME=

# ---- Direct Postgres (DDL only) ----
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Used by npm run db:apply and npm run seed; the REST API keys cannot run DDL.
DATABASE_URL=

# ---- Optional features ----
# Comma-separated: baseline_metrics, doctor_referral, voice_intake, referral_tracking,
# follow_up_tracking.
# LEAVE THIS UNSET in a normal deployment: every released feature is then on,
# which is what the code in this repository ships. Set it to a shorter list to
# run with only some of them, or to an empty string to turn all of them off and
# get the demo checkpoint's behaviour. An unknown name is ignored with a
# warning, never enabled. Apply migrations 14-19 before running with the
# defaults; a database behind on them should run with FEATURE_FLAGS= instead.
# FEATURE_FLAGS=

# ---- Limits ----
# A clinic sits behind ONE public address, so a limit keyed by address is a
# limit on the whole building. Everything that runs after sign-in is therefore
# counted per member of staff instead, and these are those numbers.
#
# AI and OCR calls per signed-in user per minute.
RATE_LIMIT_AI_PER_MIN=20
# Patient lookups per signed-in user per 5 minutes.
RATE_LIMIT_PATIENT_SEARCH=60
# Runaway guard for everything under /api. Keyed by address, because it runs
# before anyone is identified — so this is a whole centre's budget, not one
# person's.
RATE_LIMIT_GLOBAL_PER_MIN=1200
# Failed sign-ins per address AND account per 15 minutes. Successful sign-ins
# never count, and keying on the account stops one person's typos locking out
# everyone else in the building.
RATE_LIMIT_LOGIN_FAILURES=10
# The hospital acknowledgement link: requests per address per 10 minutes.
RATE_LIMIT_PUBLIC_REFERRAL=60

# ---- Model learning (Roadmap v3, F3) ----
# A candidate model is rebuilt automatically after completed, consented visits.
# It goes live only when the super admin promotes it — or, with this set to
# true, automatically when it is not worse on the frozen benchmark.
LEARN_AUTO_PROMOTE=false
# How many training rows one verified clinic case counts as.
LEARN_EXAMPLE_WEIGHT=10

# ---- Content security policy ----
# Unset or false: the policy is sent as Content-Security-Policy-Report-Only —
# browsers report what it would block to /api/csp-report and nothing is blocked.
# Set to true only once those reports are quiet.
CSP_ENFORCE=false

# ---- Operations ----
# API calls slower than this are logged once, with their request ID.
SLOW_REQUEST_MS=5000
# How long a deploy waits for in-flight requests before exiting anyway.
SHUTDOWN_GRACE_MS=10000
# Where npm run db:backup writes. Defaults to backups/, which is gitignored;
# the script refuses any path git would pick up, because a dump is full
# patient data.
BACKUP_DIR=
