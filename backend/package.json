{
  "name": "virtual-village-clinic-backend",
  "version": "1.0.0",
  "description": "Backend API for Virtual Village Clinic AI Platform",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "rag:seed": "node src/scripts/seedQdrant.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "check": "node src/scripts/checkServices.js",
    "seed:staff": "node src/scripts/seedStaffAccounts.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.17.0",
    "@qdrant/js-client-rest": "^1.11.0",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "groq-sdk": "^0.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "resend": "^3.5.0",
    "tesseract.js": "^5.1.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0"
  }
}
