# Copy to frontend/.env and fill in.
# Base path for API calls. Leave as /api when the backend serves this app.
VITE_API_URL=/api

# Supabase project, used for realtime subscriptions.
# The anon key belongs in the browser bundle by design; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Video calling (TURN) ----
# Calls use peer-to-peer WebRTC with the app's own WebSocket for signaling.
# STUN alone is enough when both parties can reach each other directly. It is
# NOT enough across most mobile networks, carrier-grade NAT, or restrictive
# venue wifi — those need a TURN relay, or the call connects and then carries
# no media.
#
# UNSET = calls may fail between different networks. See docs/PHASE2_PROGRESS.md.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---- Demo build only ----
# When true, the sign-in page shows the seeded assistant/doctor emails as
# clickable hints. Passwords are NEVER included, and admin accounts are never
# listed. Leave unset for any real deployment.
VITE_DEMO_MODE=false
VITE_DEMO_ASSISTANT_EMAIL=
VITE_DEMO_DOCTOR_EMAIL=
