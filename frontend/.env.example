# Copy to frontend/.env and fill in.
# Base path for API calls. Leave as /api when the backend serves this app.
VITE_API_URL=/api

# Supabase project, used for realtime subscriptions.
# The anon key belongs in the browser bundle by design; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
