# Node modules
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files
.env
backend/.env
frontend/.env
*.env.local
# .env.production was tracked once and went stale: it named a backend host and a
# /signal endpoint that no longer exist, and nothing read it. Ignored so a build
# never silently inherits a dead address again.
*.env.production

# Build output
dist/
frontend/dist/
build/

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Seeded demo logins — generated by `npm run seed`, never committed
database/v2/DEMO_CREDENTIALS.md

# Kaggle API credentials — never commit
.kaggle/
kaggle.json
AI/LLM/data/raw/
AI/LLM/.venv/
**/__pycache__/
*.pyc
